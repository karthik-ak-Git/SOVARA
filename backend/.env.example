# Copy to .env for local runs. Never commit real secrets.
SOVARA_ENV=development
SOVARA_APP_NAME=SOVARA
SOVARA_APP_VERSION=0.1.0
SOVARA_API_PREFIX=/api/v1
SOVARA_HOST=127.0.0.1
SOVARA_PORT=8000
SOVARA_LOG_LEVEL=INFO
SOVARA_LOG_CONFIDENTIAL_CONTENT=false
# Network policy: local-only by default (air-gap ready).
SOVARA_NETWORK_LOCAL_ONLY=true
SOVARA_NETWORK_ALLOWED_ENDPOINTS=
SOVARA_NETWORK_AUDIT_LOG=true
# Auth placeholder (no real auth in Phase 0).
SOVARA_AUTH_MODE=disabled
# Model gateway (Phase 1 / Slice 1): ollama | lmstudio | echo (echo = dev harness, non-prod).
# Slice 3: MODEL_PROVIDER selects the primary runtime + default; ENABLED_PROVIDERS
# lists every local runtime that coexists (comma-separated subset of
# lmstudio,ollama,echo). Echo joins automatically when MODEL_PROVIDER=echo.
SOVARA_MODEL_PROVIDER=ollama
SOVARA_MODEL_DEFAULT_ID=local-default
SOVARA_ENABLED_PROVIDERS=lmstudio,ollama
# Slice 3: deterministic smart routing ("SOVARA Auto", default true).
# Manual model selection always remains available as an explicit override.
SOVARA_ROUTING_ENABLED=true
SOVARA_OLLAMA_BASE_URL=http://127.0.0.1:11434
SOVARA_OLLAMA_MODEL=llama3.1
SOVARA_OLLAMA_TIMEOUT_S=10
# LM Studio (OpenAI-compatible server, default :1234). LMSTUDIO_MODEL must
# match a model currently loaded in LM Studio (see its server panel,
# or GET http://127.0.0.1:1234/v1/models).
SOVARA_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
SOVARA_LMSTUDIO_MODEL=local-model
SOVARA_LMSTUDIO_TIMEOUT_S=10
# Browser origins allowed to call the API (local UI dev). Empty = locked down.
SOVARA_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SOVARA_CHAT_TIMEOUT_S=180
SOVARA_CHAT_MAX_MESSAGES=64
SOVARA_CHAT_MAX_PROMPT_CHARS=24000
