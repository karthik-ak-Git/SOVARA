# Copy to .env for local runs. Never commit real secrets.
SOVARA_ENV=development
SOVARA_APP_NAME=SOVARA
SOVARA_APP_VERSION=0.1.0
SOVARA_API_PREFIX=/api/v1
SOVARA_HOST=127.0.0.1
SOVARA_PORT=8000
SOVARA_LOG_LEVEL=INFO
SOVARA_LOG_CONFIDENTIAL_CONTENT=false
# Network policy: local-only by default (air-gap ready).
SOVARA_NETWORK_LOCAL_ONLY=true
SOVARA_NETWORK_ALLOWED_ENDPOINTS=
SOVARA_NETWORK_AUDIT_LOG=true
# Auth placeholder (no real auth in Phase 0).
SOVARA_AUTH_MODE=disabled
