# ── Sovara Web (Next.js) — environment configuration ──────────────────────────
# Copy to .env.local for local development. NEVER commit .env.local.
#
# SERVER-ONLY secrets live here (no NEXT_PUBLIC_ prefix → never sent to browser).

# Data directory for SQLite DB, sessions, registry, downloads, MCP servers.
# Defaults to the OS-appropriate app-data folder (same location the Electron
# build uses), so the web server and desktop app share one source of truth.
# SOVARA_DATA_DIR=

# Pinned app version reported by /api/app/info (defaults to package.json).
# SOVARA_VERSION=

# Hugging Face token for gated model downloads/catalog (server-side only).
# HF_TOKEN=

# ── PUBLIC client configuration (safe to expose, NEXT_PUBLIC_ prefix) ──────

# Base URL the browser uses for internal API calls. Leave empty for same-origin.
# NEXT_PUBLIC_SOVARA_API_BASE=
