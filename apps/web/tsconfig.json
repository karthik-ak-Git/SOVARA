{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../desktop/src/shared/*"],
      "@sovara-main/*": ["../desktop/src/main/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../desktop/src/shared/**/*", "../desktop/src/main/backend/**/*", "../desktop/src/main/services/**/*", "../desktop/src/main/storage/**/*", "../desktop/src/main/config/**/*", "../desktop/src/main/network/**/*", "../desktop/src/main/logging/**/*"],
  "exclude": ["node_modules"]
}
